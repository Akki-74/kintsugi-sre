# ==============================================================================
# Kintsugi-AI — Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration ('groq' or 'lm_studio')
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local LLM Fallback (LM Studio / Ollama on RTX 500 Ada)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-3b-instruct

# Live Observability Endpoints (kind cluster port-forwards)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# Kubernetes Cluster Configuration
K8S_NAMESPACE=hipster
CLUSTER_MODE=LIVE_K8S
