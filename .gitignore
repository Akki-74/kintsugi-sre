# ==============================================================================
# Kintsugi-AI — Clean Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode & Packaging Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 2. Virtual Environments (anchored so frontend/src/lib/ etc. stay tracked)
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
/bin/
/include/
/Lib/
# Keep project scripts/ while still ignoring Windows Python Scripts/ cache
!scripts/
!scripts/**
scripts/**/__pycache__/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
out/
.vite/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
# Note: frontend/dist/ is tracked for Render deployments without Docker
!frontend/dist/
!frontend/dist/**

# ------------------------------------------------------------------------------
# 4. Testing, Profiling & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 5. Secrets, Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.csr
id_rsa
id_ed25519
/secrets/
*.secret
*credentials*.json
service-account*.json

# ------------------------------------------------------------------------------
# 6. Kubernetes, Docker & Local Infrastructure
# ------------------------------------------------------------------------------
.kube/
kubeconfig
*.kubeconfig
kind-config*.yaml.bak
docker-compose.override.yml
*.dockerignore.bak

# ------------------------------------------------------------------------------
# 7. Logs, Reports & Temporary Files
# ------------------------------------------------------------------------------
*.log
/logs/
/log/
/tmp/
/temp/
/scratch/
.agent/
*.tmp
*.bak
*.swp
*.swo
*~
kintsugi-incident-report-*.json

# ------------------------------------------------------------------------------
# 8. Operating System Specific
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 9. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/
