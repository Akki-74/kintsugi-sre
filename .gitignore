# ==============================================================================
# Kintsugi-AI — Comprehensive Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Bytecode Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
Lib/
Scripts/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
frontend/dist/
dist/
out/
.vite/
*/.vite/
frontend/.vite/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Testing, Profiling & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 5. Secrets, Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.csr
id_rsa
id_ed25519
secrets/
*.secret
*credentials*.json
service-account*.json

# ------------------------------------------------------------------------------
# 6. Kubernetes, Docker & Local Infrastructure
# ------------------------------------------------------------------------------
.kube/
kubeconfig
*.kubeconfig
kind-config*.yaml.bak
docker-compose.override.yml
*.dockerignore.bak

# ------------------------------------------------------------------------------
# 7. Logs, Diagnostics & Temporary Dumps
# ------------------------------------------------------------------------------
*.log
logs/
log/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
scratch/
.agent/

# ------------------------------------------------------------------------------
# 8. Operating System Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
# Linux
*~

# ------------------------------------------------------------------------------
# 9. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/
